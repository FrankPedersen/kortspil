{
  "name": "@kortspil/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "tsx --test test/*.test.ts",
    "contracts:generate": "tsx scripts/generate-openapi.ts && openapi-typescript ../contracts/openapi.json -o ../contracts/api-types.d.ts",
    "check": "npm run build && npm test && npm run contracts:generate"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "@azure/monitor-opentelemetry": "^1.20.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@fastify/swagger": "^9.9.2",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.7",
    "mssql": "^12.7.13"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.10.0",
    "openapi-typescript": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.3"
  }
}
